# =============================================================================
# Residencia la Luz · variables de entorno
# Copia este archivo como .env.local (desarrollo) o configúralas en Vercel.
# NUNCA subas al repositorio un archivo con valores reales.
# =============================================================================

# --- Supabase (Project Settings › API) --------------------------------------
# URL del proyecto. Pública.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). Pública: la seguridad la da RLS.
# (Se admite también la clave "anon" antigua en NEXT_PUBLIC_SUPABASE_ANON_KEY.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
# Se usa para: guardar mensajes del formulario, limitar intentos de acceso
# e invitar usuarios. (Se admite también SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=

# --- Web ---------------------------------------------------------------------
# Dirección pública definitiva (sin barra final). Se usa en sitemap, enlaces
# de los correos de recuperación y metadatos para redes sociales.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta privada del panel de gestión. Elige una difícil de adivinar
# (solo minúsculas, números y guiones). No es una medida de seguridad por sí
# sola: el panel exige siempre sesión, rol y RLS.
ADMIN_PATH=/gestion-centro

# --- Solo para el script de creación de cuentas (opcional) --------------------
# Si no se indica, el script genera una contraseña aleatoria y la muestra una vez.
# ADMIN_PASSWORD=
